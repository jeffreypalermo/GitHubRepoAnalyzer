<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GithubDashboard</RootNamespace>
    <AssemblyName>gh-dashboard</AssemblyName>
    <!-- major.minor base — CI sets patch = github.run_number at publish time.  -->
    <!-- To cut a named release: git tag v1.2.0 && git push origin v1.2.0      -->
    <Version>1.1.0</Version>
    <Description>GitHub repository analytics dashboard — TUI powered by Spectre.Console</Description>
    <Authors>Clear Measure</Authors>
    <PackageId>GithubDashboard.Tool</PackageId>
    <RepositoryUrl>https://github.com/jeffreypalermo/GitHubRepoAnalyzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Publish as a dotnet global tool so it appears in GitHub Packages -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gh-dashboard</ToolCommandName>

    <!-- Single-file self-contained publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming disabled: JsonSerializer uses reflection-based deserialization -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

</Project>
